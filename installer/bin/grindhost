#! /bin/bash
######################################################################
# Launch the host process under valgrind.

#### Configuration

# Path to the valgrind application
valgrind=/usr/bin/valgrind
# Arguments for valgrind
valargs="--tool=callgrind --separate-threads=yes --collect-jumps=yes --collect-systime=yes --separate-callers=4 --collect-bus=yes --dump-instr=yes"

tarfile="${HOME}/${BE_ROLE/d/}grind.tar"

if [ ! -x /usr/bin/valgrind ] ; then
  echo "'valgrind' is not installed."
  exit 1
fi

BE_ROLE=${BE_ROLE:-`cat ${HOME}/etc/berole.rc`}
if [ -z "${BE_ROLE}" ] ; then
  echo "BE_ROLE not defined"
  exit 1
fi

if [ ! -z $(pidof "${BE_ROLE}") ] ; then
  stophost
fi

basepath="${HOME}/${BE_ROLE}"
if ! cd "${basepath}" ; then
  echo "Unable to cd to /home/wwiiol/${BE_ROLE}"
  exit 1
fi

rm -f call*.* ${tarfile} ${tarfile}.bz2

cmd="${valgrind} ${valargs} $* /playnet/wwiiol/bin/${BE_ROLE}"
if [ ${DEBUG} ] ; then echo "+ $cmd" ; fi
eval $cmd

if [ ${DEBUG} ] ; then echo "+ Creating ${tarfile}.bz2" ; fi
tar cf ${tarfile} call*.*
bzip2 -9 ${tarfile}

